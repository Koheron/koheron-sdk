#!/bin/sh
set -eu

STAMP=/var/lib/grow-rootfs-done
[ -e "$STAMP" ] && exit 0

ROOTDEV="$(findmnt -no SOURCE /)"
# Expect /dev/mmcblk0p2
case "$ROOTDEV" in
  /dev/mmcblk0p2) ;;
  *) echo "grow-rootfs-once: root is $ROOTDEV, skipping"; exit 0 ;;
esac

# Change only partition 2's size. -N preserves its start, type and boot flags;
# explicit wipe suppression keeps filesystem signatures and data intact.
# The kernel receives the updated size through partx below.
if printf ',+\n' | sfdisk --no-reread --no-tell-kernel --wipe never --wipe-partitions never -N 2 /dev/mmcblk0; then
  :
else
  result=$?
  echo "grow-rootfs-once: partition expansion failed (exit $result)" >&2
  exit "$result"
fi

# Refresh this partition even when already full, so retries also pick up a
# previous on-disk expansion. A whole-disk reread can fail on a mounted root.
partx --update --nr 2 /dev/mmcblk0
udevadm settle

# Grow the ext4 filesystem online
resize2fs /dev/mmcblk0p2

mkdir -p "$(dirname "$STAMP")"
touch "$STAMP"
echo "grow-rootfs-once: done"
exit 0

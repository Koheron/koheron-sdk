[Unit]
Description=Display last digit of IP address on leds
Requires=koheron-server.service
After=koheron-server.service

[Service]
# DHCP may arrive after boot. This helper waits without blocking the target.
Type=simple
ExecStart=/usr/local/api/koheron-server-init
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target

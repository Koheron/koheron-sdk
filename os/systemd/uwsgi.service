# /etc/systemd/system/uwsgi.service
[Unit]
Description=uWSGI HTTP API (started at boot, runs as root)
DefaultDependencies=no
After=sysinit.target local-fs.target systemd-tmpfiles-setup.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=notify
NotifyAccess=all
User=root
Group=root
Sockets=uwsgi.socket
# uWSGI imports systemd's LISTEN_FDS automatically (starting at fd 3).
ExecStart=/usr/bin/uwsgi --ini /etc/uwsgi/uwsgi.ini --plugin python3
Restart=always
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target

/* Autogenerated from memory.yml — do not edit by hand.
 * Intended to be /include/-ed from a wrapper that provides /dts-v1/ and /plugin/.
 */

&amba {
    #address-cells = <{{ 2 if arch == 'arm64' else 1 }}>;
    #size-cells    = <{{ 2 if arch == 'arm64' else 1 }}>;
{%- for r in regions %}
    kmem_{{ r.name }}: {{ r.name }}@{{ "%08x"|format(r.base) }} {
        compatible = {{ r.compat_str }};
{% if arch == 'arm64' %}
        reg = <0x00000000 0x{{ "%08x"|format(r.base) }} 0x00000000 0x{{ "%08x"|format(r.size) }}>;
{% else %}
        reg = <0x{{ "%08x"|format(r.base) }} 0x{{ "%08x"|format(r.size) }}>;
{% endif %}
    };
{%- endfor %}
};

/* Use requested rates: reapplying HSI's rounded output can select a slower
 * divider when Linux rounds that approximation down a second time. */
{% for index, rate in fclk_rates.items() %}
&clocking{{ index }} {
    assigned-clock-rates = <{{ rate }}>;
};
{% endfor %}
